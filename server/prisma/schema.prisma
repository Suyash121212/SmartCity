generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model City {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  issues    Issue[]
  users     User[]
  zones     Zone[]
}

model Zone {
  id        String   @id @default(uuid())
  name      String
  cityId    String
  createdAt DateTime @default(now())
  issues    Issue[]
  users     User[]
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, name])
}

model User {
  id                 String         @id @default(uuid())
  name               String
  email              String         @unique
  password           String
  role               Role           @default(CITIZEN)
  cityId             String?
  zoneId             String?
  department         String?
  avatar             String?
  refreshToken       String?
  profileComplete    Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  mustChangePassword Boolean        @default(false)
  comments           Comment[]
  issues             Issue[]
  statusUpdates      StatusUpdate[]
  upvotes            Upvote[]
  city               City?          @relation(fields: [cityId], references: [id])
  zone               Zone?          @relation(fields: [zoneId], references: [id])
}

model Issue {
  id           String         @id @default(uuid())
  title        String
  description  String
  category     Category
  priority     Priority       @default(LOW)
  status       Status         @default(REPORTED)
  photoUrl     String?
  lat          Float
  lng          Float
  aiAnalysis   Json?
  upvoteCount  Int            @default(0)
  userId       String
  cityId       String?
  zoneId       String?
  assignedToId String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  resolvedAt   DateTime?
  comments     Comment[]
  city         City?          @relation(fields: [cityId], references: [id])
  user         User           @relation(fields: [userId], references: [id])
  zone         Zone?          @relation(fields: [zoneId], references: [id])
  updates      StatusUpdate[]
  upvotes      Upvote[]
}

model StatusUpdate {
  id          String   @id @default(uuid())
  issueId     String
  authorityId String
  status      Status
  note        String
  createdAt   DateTime @default(now())
  authority   User     @relation(fields: [authorityId], references: [id])
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String     @id @default(uuid())
  issueId   String
  userId    String
  content   String
  sentiment Sentiment?
  createdAt DateTime   @default(now())
  issue     Issue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id])
}

model Upvote {
  id        String   @id @default(uuid())
  issueId   String
  userId    String
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([issueId, userId])
}

enum Role {
  CITIZEN
  AUTHORITY
  ADMIN
}

enum Category {
  ROAD
  SANITATION
  WATER
  ELECTRICITY
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Status {
  REPORTED
  IN_REVIEW
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  FRUSTRATED
}
